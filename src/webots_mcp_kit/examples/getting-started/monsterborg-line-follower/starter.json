{
  "name": "monsterborg-line-follower",
  "title": "MonsterBorg line-follower starter workspace",
  "flow": "evaluator",
  "support_tier": "experimental-foundation",
  "expected_green": "controller validate passes and the MonsterBorg line-follower benchmark reports pass.",
  "recommended_commands": [
    "webots-kit controller validate .\\controllers\\demo_agent.py --scenario line-follower --robot-profile monsterborg-4wd --strict --json",
